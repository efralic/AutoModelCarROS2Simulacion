<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>bring_up</name>
  <version>1.0.0</version>
  <description>
    Launch files y scripts que arman los 4 escenarios de simulación del TMR
    (sin obstáculos, obstáculos estáticos, obstáculos dinámicos y
    estacionamiento) sobre autonomos_gazebo_simulation y gazebo_plugin.
    Puerto a ROS 2 Humble del paquete bring_up original (ROS 1).
  </description>

  <maintainer email="efrain@example.com">Efrain</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>autonomos_gazebo_simulation</exec_depend>
  <exec_depend>gazebo_plugin</exec_depend>
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>gazebo_msgs</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <!-- Paquetes de percepción/control: se asume que AutoModelCarROS2 está
       clonado como paquetes hermanos en el mismo workspace (src/). -->
  <exec_depend>lane_detection</exec_depend>
  <exec_depend>object_detection</exec_depend>
  <exec_depend>object_detection_parking</exec_depend>
  <exec_depend>control</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
