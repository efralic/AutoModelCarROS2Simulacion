<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>control</name>
  <version>0.0.0</version>
  <description>Control package – Masters autónomos del carrito AVIM (ROS 2)</description>

  <maintainer email="jose@todo.todo">jose</maintainer>
  <license>TODO</license>

  <!-- Build tool: catkin → ament_cmake -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- ROS 1: <depend>roscpp</depend>  →  ROS 2: rclcpp -->
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>

  <!-- Paquete con el mensaje custom PointsObjects -->
  <depend>object_detection</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
