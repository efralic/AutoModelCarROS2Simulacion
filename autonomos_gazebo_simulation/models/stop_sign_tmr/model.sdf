<?xml version="1.0" ?>
<!--
  stop_sign_tmr: señal de ALTO a escala (≈1:10) para la pista TMR.

  - Octágono rojo de 15 cm (de lado a lado) con borde blanco, centro a
    0.25 m del piso, sobre un poste gris. Parte trasera gris.
  - La CARA ROJA mira hacia +x del modelo. En el .world, el yaw del <pose>
    se elige para que +x apunte hacia el carro que se acerca:
        carro que va hacia +y (norte) -> yaw = -1.5708
        carro que va hacia -y (sur)   -> yaw =  1.5708
        carro que va hacia +x (este)  -> yaw =  3.1416
        carro que va hacia -x (oeste) -> yaw =  0
  - El origen del modelo es la base del poste.
  - Los octágonos son <polyline> (extrusión en z); con pitch = +90° la
    extrusión queda a lo largo de +x del modelo.
  - Material con <emissive>: el rojo se ve igual de saturado aunque la luz
    de la escena sea tenue (el detector usa umbrales HSV).
  - Colisión solo en el poste (no estorba a los ultrasónicos).
-->
<sdf version="1.6">
  <model name="stop_sign_tmr">
    <static>true</static>
    <link name="link">

      <collision name="poste_col">
        <pose>0 0 0.1250 0 0 0</pose>
        <geometry><cylinder><radius>0.008</radius><length>0.2500</length></cylinder></geometry>
      </collision>

      <visual name="poste">
        <pose>0 0 0.1250 0 0 0</pose>
        <geometry><cylinder><radius>0.008</radius><length>0.2500</length></cylinder></geometry>
        <material>
          <ambient>0.45 0.45 0.45 1</ambient>
          <diffuse>0.45 0.45 0.45 1</diffuse>
        </material>
      </visual>

      <!-- Respaldo gris (lo que se ve desde atrás) -->
      <visual name="respaldo">
        <pose>0.008 0 0.2500 0 1.5708 0</pose>
        <geometry>
          <polyline>
            <point>0.0785 0.0325</point>
            <point>0.0325 0.0785</point>
            <point>-0.0325 0.0785</point>
            <point>-0.0785 0.0325</point>
            <point>-0.0785 -0.0325</point>
            <point>-0.0325 -0.0785</point>
            <point>0.0325 -0.0785</point>
            <point>0.0785 -0.0325</point>
            <height>0.003</height>
          </polyline>
        </geometry>
        <material>
          <ambient>0.5 0.5 0.5 1</ambient>
          <diffuse>0.5 0.5 0.5 1</diffuse>
        </material>
      </visual>

      <!-- Borde blanco -->
      <visual name="borde_blanco">
        <pose>0.011 0 0.2500 0 1.5708 0</pose>
        <geometry>
          <polyline>
            <point>0.0785 0.0325</point>
            <point>0.0325 0.0785</point>
            <point>-0.0325 0.0785</point>
            <point>-0.0785 0.0325</point>
            <point>-0.0785 -0.0325</point>
            <point>-0.0325 -0.0785</point>
            <point>0.0325 -0.0785</point>
            <point>0.0785 -0.0325</point>
            <height>0.002</height>
          </polyline>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <emissive>0.35 0.35 0.35 1</emissive>
        </material>
      </visual>

      <!-- Cara roja -->
      <visual name="cara_roja">
        <pose>0.013 0 0.2500 0 1.5708 0</pose>
        <geometry>
          <polyline>
            <point>0.0693 0.0287</point>
            <point>0.0287 0.0693</point>
            <point>-0.0287 0.0693</point>
            <point>-0.0693 0.0287</point>
            <point>-0.0693 -0.0287</point>
            <point>-0.0287 -0.0693</point>
            <point>0.0287 -0.0693</point>
            <point>0.0693 -0.0287</point>
            <height>0.002</height>
          </polyline>
        </geometry>
        <material>
          <ambient>0.85 0 0 1</ambient>
          <diffuse>0.85 0 0 1</diffuse>
          <emissive>0.55 0 0 1</emissive>
        </material>
      </visual>

    </link>
  </model>
</sdf>
