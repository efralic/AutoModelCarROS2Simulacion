<sdf version='1.3'>
  <model name='AutoNOMOS_mini'>
   
    <link name='base_link'>
    </link>

    <link name="body">
      	<inertial>
	        <mass>6</mass>
	        <inertia>
	          <ixx>0.0067</ixx>
	          <ixy>0.000000</ixy>
	          <ixz>0.00088</ixz>
	          <iyy>0.07846</iyy>
	          <iyz>0.000000</iyz>
	          <izz>0.08387</izz>
	        </inertia>
      	</inertial>
      
	    <visual name="visual_body">
	      	<geometry>
				<mesh><uri>model://AutoNOMOS_mini/meshes/autonomos.dae</uri></mesh>
	      	</geometry>
	    </visual>

	    <collision name="collision_body">
	    	<geometry>
				<mesh><uri>model://AutoNOMOS_mini/meshes/autonomos.dae</uri></mesh>
	      	</geometry>
	    </collision>

	    <sensor name="imu_sensor" type="imu">
	      <always_on>true</always_on>
	      <update_rate>50</update_rate>
	      <visualize>true</visualize>
	      <topic>__default_topic__</topic>
	      <plugin filename="libgazebo_ros_imu_sensor.so" name="imu_plugin">
	        <topicName>imu</topicName>
	        <updateRateHZ>10.0</updateRateHZ>
	        <gaussianNoise>0.0</gaussianNoise>
	        <xyzOffset>0 0 0</xyzOffset>
	        <rpyOffset>0 0 0</rpyOffset>
	        <frameName>imu_link</frameName>
	      </plugin>
	      <pose>0 0 0 0 0 0</pose>
	    </sensor>
    </link>

    <joint name="base_link_to_body" type="fixed">
    	<pose>0.000000 0.000000 0.000000 0.000000 0.000000 0.000000</pose>
    	<parent>base_link</parent>
		<child>body </child>
    </joint>
    
    <link name='back_left_wheel_link'>
      <pose>-0.125000 0.100000 0.0100000 1.570800 0.000000 0.000000</pose>
      <inertial>
        <mass>0.010000</mass>
        <inertia>
          <ixx>0.010000</ixx>
          <ixy>0.000000</ixy>
          <ixz>0.000000</ixz>
          <iyy>0.010000</iyy>
          <iyz>0.000000</iyz>
          <izz>0.010000</izz>
        </inertia>
      </inertial>
      <collision name='back_left_wheel_link_geom'>
        <geometry>
          <cylinder>
            <length>0.01000</length>
            <radius>0.03000</radius>
          </cylinder>
        </geometry>
      </collision>
      <visual name='back_left_wheel_link_visual'>
        <geometry>
          <cylinder>
            <length>0.01000</length>
            <radius>0.03000</radius>
          </cylinder>
        </geometry>
        <material>
          <script>
            <name>Gazebo/White</name>
          </script>
        </material>
      </visual>
    </link>

    <joint name='back_left_wheel_joint' type='revolute'>
      <child>back_left_wheel_link</child>
      <parent>base_link</parent>
      <axis>
        <xyz>0.000000 1.000000 0.000000</xyz>
        <limit>
          <lower>-10000000000000000.000000</lower>
          <upper>10000000000000000.000000</upper>
        </limit>
      </axis>
    </joint>

    <link name='back_right_wheel_link'>
      <pose>-0.125000 -0.100000 0.0100000 1.570800 0.000000 0.000000</pose>
      <inertial>
        <mass>0.010000</mass>
        <inertia>
          <ixx>0.010000</ixx>
          <ixy>0.000000</ixy>
          <ixz>0.000000</ixz>
          <iyy>0.010000</iyy>
          <iyz>0.000000</iyz>
          <izz>0.010000</izz>
        </inertia>
      </inertial>
      <collision name='back_right_wheel_link_geom'>
        <geometry>
          <cylinder>
            <length>0.01000</length>
            <radius>0.030000</radius>
          </cylinder>
        </geometry>
      </collision>
      <visual name='back_right_wheel_link_visual'>
        <geometry>
          <cylinder>
            <length>0.01000</length>
            <radius>0.030000</radius>
          </cylinder>
        </geometry>
        <material>
          <script>
            <name>Gazebo/White</name>
          </script>
        </material>
      </visual>
    </link>

    <joint name='back_right_wheel_joint' type='revolute'>
      <child>back_right_wheel_link</child>
      <parent>base_link</parent>
      <axis>
        <xyz>0.000000 1.000000 0.000000</xyz>
        <limit>
          <lower>-10000000000000000.000000</lower>
          <upper>10000000000000000.000000</upper>
        </limit>
      </axis>
    </joint>

    <link name='front_left_bar_link'>
      <pose>0.125000 0.060000 0.0100000 0.000000 0.000000 0.000000</pose>
      <inertial>
        <mass>0.010000</mass>
        <inertia>
          <ixx>0.010000</ixx>
          <ixy>0.000000</ixy>
          <ixz>0.000000</ixz>
          <iyy>0.010000</iyy>
          <iyz>0.000000</iyz>
          <izz>0.010000</izz>
        </inertia>
      </inertial>
      <collision name='front_left_bar_link_geom'>
        <geometry>
          <box>
            <size>0.040000 0.020000 0.005000</size>
          </box>
        </geometry>
      </collision>
      <visual name='front_left_bar_link_visual'>
        <geometry>
          <box>
            <size>0.040000 0.020000 0.005000</size>
          </box>
        </geometry>
        <material>
          <script>
            <name>Gazebo/Red</name>
          </script>
        </material>
      </visual>
    </link>

    <joint name='front_left_bar_joint' type='revolute'>
      <child>front_left_bar_link</child>
      <parent>base_link</parent>
      <axis>
        <xyz>0.000000 0.000000 1.000000</xyz>
        <limit>
          <lower>-0.500000</lower>
          <upper>0.500000</upper>
        </limit>
      </axis>
    </joint>

    <link name='front_left_wheel_link'>
      <pose>0.125000 0.100000 0.0100000 1.570800 0.000000 0.000000</pose>
      <inertial>
        <mass>0.010000</mass>
        <inertia>
          <ixx>0.010000</ixx>
          <ixy>0.000000</ixy>
          <ixz>0.000000</ixz>
          <iyy>0.010000</iyy>
          <iyz>0.000000</iyz>
          <izz>0.010000</izz>
        </inertia>
      </inertial>
      <collision name='front_left_wheel_link_geom'>
        <geometry>
          <cylinder>
            <length>0.01000</length>
            <radius>0.030000</radius>
          </cylinder>
        </geometry>
      </collision>
      <visual name='front_left_wheel_link_visual'>
        <geometry>
          <cylinder>
            <length>0.01000</length>
            <radius>0.030000</radius>
          </cylinder>
        </geometry>
        <material>
          <script>
            <name>Gazebo/White</name>
          </script>
        </material>
      </visual>
    </link>

    <joint name='front_left_wheel_joint' type='revolute'>
      <child>front_left_wheel_link</child>
      <parent>front_left_bar_link</parent>
      <axis>
        <xyz>0.000000 1.000000 0.000000</xyz>
        <limit>
          <lower>-10000000000000000.000000</lower>
          <upper>10000000000000000.000000</upper>
        </limit>
        <dynamics/>
      </axis>
    </joint>

    <link name='front_right_bar_link'>
      <pose>0.125000 -0.060000 0.0100000 0.000000 0.000000 0.000000</pose>
      <inertial>
        <mass>0.010000</mass>
        <inertia>
          <ixx>0.010000</ixx>
          <ixy>0.000000</ixy>
          <ixz>0.000000</ixz>
          <iyy>0.010000</iyy>
          <iyz>0.000000</iyz>
          <izz>0.010000</izz>
        </inertia>
      </inertial>
      <collision name='front_right_bar_link_geom'>
        <geometry>
          <box>
            <size>0.040000 0.020000 0.005000</size>
          </box>
        </geometry>
      </collision>
      <visual name='front_right_bar_link_visual'>
        <geometry>
          <box>
            <size>0.040000 0.020000 0.005000</size>
          </box>
        </geometry>
        <material>
          <script>
            <name>Gazebo/Red</name>
          </script>
        </material>
      </visual>
    </link>

    <joint name='front_right_bar_joint' type='revolute'>
      <child>front_right_bar_link</child>
      <parent>base_link</parent>
      <axis>
        <xyz>0.000000 0.000000 1.000000</xyz>
        <limit>
          <lower>-0.500000</lower>
          <upper>0.500000</upper>
        </limit>
        <dynamics/>
      </axis>
    </joint>

    <link name='front_right_wheel_link'>
      <pose>0.125000 -0.100000 0.0100000 1.570800 0.000000 0.000000</pose>
      <inertial>
        <mass>0.010000</mass>
        <inertia>
          <ixx>0.010000</ixx>
          <ixy>0.000000</ixy>
          <ixz>0.000000</ixz>
          <iyy>0.010000</iyy>
          <iyz>0.000000</iyz>
          <izz>0.010000</izz>
        </inertia>
      </inertial>
      <collision name='front_right_wheel_link_geom'>
        <geometry>
          <cylinder>
            <length>0.01000</length>
            <radius>0.030000</radius>
          </cylinder>
        </geometry>
      </collision>
      <visual name='front_right_wheel_link_visual'>
        <geometry>
          <cylinder>
            <length>0.01000</length>
            <radius>0.030000</radius>
          </cylinder>
        </geometry>
        <material>
          <script>
            <name>Gazebo/White</name>
          </script>
        </material>
      </visual>
    </link>

    <joint name='front_right_wheel_joint' type='revolute'>
      <child>front_right_wheel_link</child>
      <parent>front_right_bar_link</parent>
      <axis>
        <xyz>0.000000 1.000000 0.000000</xyz>
        <limit>
          <lower>-10000000000000000.000000</lower>
          <upper>10000000000000000.000000</upper>
        </limit>
        <dynamics/>
      </axis>
    </joint>

    <link name='steer_link'>
      <pose>0.125000 0.000000 0.0100000 0.000000 0.000000 0.000000</pose>
      <inertial>
        <mass>0.010000</mass>
        <inertia>
          <ixx>0.010000</ixx>
          <ixy>0.000000</ixy>
          <ixz>0.000000</ixz>
          <iyy>0.010000</iyy>
          <iyz>0.000000</iyz>
          <izz>0.010000</izz>
        </inertia>
      </inertial>
      <collision name='steer_link_geom'>
        <geometry>
          <box>
            <size>0.040000 0.020000 0.005000</size>
          </box>
        </geometry>
      </collision>
      <visual name='steer_link_visual'>
        <geometry>
          <box>
            <size>0.040000 0.020000 0.005000</size>
          </box>
        </geometry>
        <material>
          <script>
            <name>Gazebo/Red</name>
          </script>
        </material>
      </visual>
    </link>

    <joint name='steer_joint' type='revolute'>
      <child>steer_link</child>
      <parent>base_link</parent>
      <axis>
        <xyz>0.000000 0.000000 1.000000</xyz>
        <limit>
          <lower>-0.500000</lower>
          <upper>0.500000</upper>
        </limit>
        <dynamics/>
      </axis>
    </joint>

    <link name='ackermann_bar_link'>
      <pose>0.11000 0.000000 0.0100000 0.000000 0.000000 0.000000</pose>
      <inertial>
        <mass>0.010000</mass>
        <inertia>
          <ixx>0.010000</ixx>
          <ixy>0.000000</ixy>
          <ixz>0.000000</ixz>
          <iyy>0.010000</iyy>
          <iyz>0.000000</iyz>
          <izz>0.010000</izz>
        </inertia>
      </inertial>
      <collision name='ackermann_bar_link_geom'>
        <geometry>
          <box>
            <size>0.020000 0.150000 0.010000</size>
          </box>
        </geometry>
      </collision>
      <visual name='ackermann_bar_link_visual'>
        <geometry>
          <box>
            <size>0.020000 0.150000 0.010000</size>
          </box>
        </geometry>
        <material>
          <script>
            <name>Gazebo/Blue</name>
          </script>
        </material>
      </visual>
    </link>

    <joint name='ackermann_joint' type='revolute'>
      <child>ackermann_bar_link</child>
      <parent>steer_link</parent>
      <axis>
        <xyz>0.000000 0.000000 1.000000</xyz>
        <limit>
          <lower>-0.500000</lower>
          <upper>0.500000</upper>
        </limit>
        <dynamics/>
      </axis>
    </joint>

    <joint name='ackermann_left_bar_joint' type='revolute'>
      <parent>front_left_bar_link</parent>
      <child>ackermann_bar_link</child>
      <axis>
        <xyz>0.000000 0.000000 1.000000</xyz>
        <limit>
          <lower>-10000000000000000.000000</lower>
          <upper>10000000000000000.000000</upper>
        </limit>
        <dynamics/>
      </axis>
      <pose>0.000000 0.060000 0.000000 0.000000 0.000000 0.000000</pose>
    </joint>

    <joint name='ackermann_right_bar_joint' type='revolute'>
      <parent>front_right_bar_link</parent>
      <child>ackermann_bar_link</child>
      <axis>
        <xyz>0.000000 0.000000 1.000000</xyz>
        <limit>
          <lower>-10000000000000000.000000</lower>
          <upper>10000000000000000.000000</upper>
        </limit>
        <dynamics/>
      </axis>
      <pose>0.000000 -0.060000 0.000000 0.000000 0.000000 0.000000</pose>
    </joint>
    
    <!-- camera_link: cámara de profundidad simulada (equivalente a la Nuwa-HP60C) -->
  	<link name="camera_link">
	  	<pose>-0.03 0.00000 0.145 0.0 0.06 0.0</pose>
	    <inertial>
	    	<mass>0.1197</mass>
	        <inertia>
	          <ixx>0.010000</ixx>
	          <ixy>0.000000</ixy>
	          <ixz>0.000000</ixz>
	          <iyy>0.010000</iyy>
	          <iyz>0.000000</iyz>
	          <izz>0.010000</izz>
	        </inertia>
	    </inertial>
	    <collision name="collision_camera_link">
	    	<geometry>
	          <box>
	            <size>0.02 0.11 0.02</size>
	          </box>
	        </geometry>
	    </collision>
	    <visual name="visual_camera_link">
	    	<geometry>
	          <box>
	            <size>0.02 0.11 0.02</size>
	          </box>
	        </geometry>
	        <material>
	          <script>
	            <name>Gazebo/Gray</name>
	          </script>
	        </material>
	    </visual>

	    <sensor name="camera" type="depth">
	        <update_rate>30</update_rate>
	        <visualize>true</visualize>
	        <always_on>1</always_on>
	        <camera name="camera">
	          <horizontal_fov>1.288</horizontal_fov> <!-- 73.8 grados, como la Nuwa-HP60C real -->
	          <image>
	            <width>640</width>
	            <height>480</height>
	            <format>R8G8B8</format>
	          </image>
	          <clip>
	            <near>0.2</near>
	            <far>4.0</far>
	          </clip>
	    	</camera>

	    	<!-- Plugin ROS2 (gazebo_ros_pkgs Humble). Sustituye a libgazebo_ros_openni_kinect.so (ROS1). -->
	    	<plugin name="camera_controller" filename="libgazebo_ros_camera.so">
		        <camera_name>camera</camera_name>
		        <frame_name>camera_link</frame_name>
		        <hack_baseline>0</hack_baseline>
		        <min_depth>0.2</min_depth>
		        <max_depth>4.0</max_depth>
	    	</plugin>
	    </sensor>
  	</link>

	<joint name="camera_joint" type="fixed">
	    <child>camera_link</child>
	    <parent>base_link</parent>
	    <axis>
	        <xyz>0.000000 0.000000 1.000000</xyz>
	    </axis>
	</joint>

    <!-- plugin with topics to control steer and speed -->
    <plugin name="test_control" filename="libautonomos_plugin.so">
      <debug>True</debug>
    </plugin>

  </model>
</sdf>
