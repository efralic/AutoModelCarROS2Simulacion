<?xml version="1.0" ?>
<sdf version="1.5">
  <world name="default">

    <!-- Habilita /get_entity_state y /set_entity_state (ROS 2). Ver
         gazebo_static_obstacles / dynamic_obstacles en bring_up. -->
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <update_rate>10.0</update_rate>
    </plugin>

    <include>
      <uri>model://ground_plane</uri>
      <pose> 0 0 -.0001 0 0 0 </pose>
    </include>
    
    <light name="inner_point_white1" type="point">
      <pose>5 3 4 0 0 0</pose>
      <diffuse>0.2 0.2 0.2 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>20</range>
        <linear>0.1</linear>
        <constant>0.2</constant>
        <quadratic>0</quadratic>
      </attenuation>
      <cast_shadows>0</cast_shadows>
      <direction>0 0 -1</direction>
    </light>
    <light name="inner_point_white2" type="point">
      <pose>0 3 4 0 0 0</pose>
      <diffuse>0.2 0.2 0.2 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>20</range>
        <linear>0.1</linear>
        <constant>0.2</constant>
        <quadratic>0</quadratic>
      </attenuation>
      <cast_shadows>0</cast_shadows>
      <direction>0 0 -1</direction>
    </light>
    <light name="inner_point_white3" type="point">
      <pose>-5 3 4 0 0 0</pose>
      <diffuse>0.2 0.2 0.2 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>20</range>
        <linear>0.1</linear>
        <constant>0.2</constant>
        <quadratic>0</quadratic>
      </attenuation>
      <cast_shadows>0</cast_shadows>
      <direction>0 0 -1</direction>
    </light>
    <light name="inner_point_white4" type="point">
      <pose>-5 -3 4 0 0 0</pose>
      <diffuse>0.2 0.2 0.2 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>20</range>
        <linear>0.1</linear>
        <constant>0.2</constant>
        <quadratic>0</quadratic>
      </attenuation>
      <cast_shadows>0</cast_shadows>
      <direction>0 0 -1</direction>
    </light>
    <light name="inner_point_white5" type="point">
      <pose>0 -3 4 0 0 0</pose>
      <diffuse>0.2 0.2 0.2 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>20</range>
        <linear>0.1</linear>
        <constant>0.2</constant>
        <quadratic>0</quadratic>
      </attenuation>
      <cast_shadows>0</cast_shadows>
      <direction>0 0 -1</direction>
    </light>
    <light name="inner_point_white6" type="point">
      <pose>5 -3 4 0 0 0</pose>
      <diffuse>0.2 0.2 0.2 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>20</range>
        <linear>0.1</linear>
        <constant>0.2</constant>
        <quadratic>0</quadratic>
      </attenuation>
      <cast_shadows>0</cast_shadows>
      <direction>0 0 -1</direction>
    </light>
    
    <include>
      <uri>model://pista_tmr_2021</uri>
      <pose> 0 0 0.01 0 0 0 </pose>
      <name>PistaTMR2021</name>
    </include>

    <!-- ═══ Señales de ALTO en los cruces peatonales ═══════════════════════
         Modelo: models/stop_sign_tmr (octágono rojo de 15 cm, cara hacia +x).
         Cada señal está a la DERECHA del carril que llega al cruce, 12 cm
         fuera de la línea del borde y 5 cm antes de la cebra. El yaw hace que
         la cara roja mire al carro que se acerca; los demás carros ven la
         parte trasera (gris).
         Para mover una: x, y en metros (1 px de Pista.png = 1 cm,
         x = (col - 600)/100, y = (400 - fila)/100).
         Para quitar una: borra (o comenta) su <include>. -->

    <!-- Cruce izquierdo (centro -0.83, -0.92) -->
    <include>
      <uri>model://stop_sign_tmr</uri>
      <name>stop_sign_1</name>
      <pose>-0.31 -1.67 0 0 0 -1.5708</pose>   <!-- carro hacia el NORTE (subiendo)  <- el carro SI pasa aqui -->
    </include>
    <include>
      <uri>model://stop_sign_tmr</uri>
      <name>stop_sign_2</name>
      <pose>-1.35 -0.28 0 0 0 1.5708</pose>   <!-- carro hacia el SUR -->
    </include>
    <include>
      <uri>model://stop_sign_tmr</uri>
      <name>stop_sign_3</name>
      <pose>-1.47 -1.44 0 0 0 3.1416</pose>   <!-- carro hacia el ESTE              <- el carro SI pasa aqui -->
    </include>
    <include>
      <uri>model://stop_sign_tmr</uri>
      <name>stop_sign_4</name>
      <pose>-0.18 -0.4 0 0 0 0.0</pose>   <!-- carro hacia el OESTE -->
    </include>

    <!-- Cruce derecho (centro 0.775, -0.92) -->
    <include>
      <uri>model://stop_sign_tmr</uri>
      <name>stop_sign_5</name>
      <pose>1.3 -1.67 0 0 0 -1.5708</pose>   <!-- carro hacia el NORTE -->
    </include>
    <include>
      <uri>model://stop_sign_tmr</uri>
      <name>stop_sign_6</name>
      <pose>0.255 -0.28 0 0 0 1.5708</pose>   <!-- carro hacia el SUR (bajando)     <- el carro SI pasa aqui -->
    </include>
    <include>
      <uri>model://stop_sign_tmr</uri>
      <name>stop_sign_7</name>
      <pose>0.13 -1.44 0 0 0 3.1416</pose>   <!-- carro hacia el ESTE              <- el carro SI pasa aqui -->
    </include>
    <include>
      <uri>model://stop_sign_tmr</uri>
      <name>stop_sign_8</name>
      <pose>1.42 -0.4 0 0 0 0.0</pose>   <!-- carro hacia el OESTE -->
    </include>

    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>1.15 1.93 2.85 0 1.08 1.07</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>
  </world>
</sdf>
